# Descargas originales de sonido: solo se suben las grabaciones que usa
# audio/mezclar_sonidos.sh y las licencias. El resto se vuelve a bajar (ver CREDITOS.md).
# Truco: "**" ignora todo en cualquier subcarpeta; "!" vuelve a incluir; "!**/" deja
# entrar a las carpetas (si una carpeta está ignorada, git no mira lo que hay dentro).
audio/descargas/**
!audio/descargas/**/
!audio/descargas/**/*.txt
!audio/descargas/gunshot_sounds/extraido/sounds/cz.wav
!audio/descargas/gunshot_sounds/extraido/sounds/mosin.wav
!audio/descargas/gunshot_sounds/extraido/sounds/sks.wav
!audio/descargas/q009/extraido/q009/explosion.ogg
!audio/descargas/q009/extraido/q009/outofammo.ogg
!audio/descargas/q009/extraido/q009/rlauncher.ogg
!audio/descargas/q009/extraido/q009/rlauncher2.ogg
!audio/descargas/q009/extraido/q009/rlauncher3.ogg
