# Texto siempre con saltos de línea LF (Godot y bash los esperan así)
* text=auto eol=lf
# Binarios: nunca tocar
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.glb binary
*.blend binary
*.hdr binary
*.exr binary
# Los scripts de Blender generan el modelo; no cuentan para el lenguaje del repo (así GitHub muestra GDScript)
blender/** linguist-detectable=false
