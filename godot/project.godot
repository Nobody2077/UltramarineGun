; UltramarineGun: simulador de bólter para la tablet (Redmi Pad 2). Ver ../LEEME.md
config_version=5

[application]

config/name="UltramarineGun"
config/version="0.2.0"
run/main_scene="res://escenas/principal.tscn"
config/icon="res://icono/icono.png"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.035, 0.05, 1)

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
